{
  "name": "pie",
  "version": "0.1.0",
  "private": true,
  "description": "Pie — dedicated cross-device app for the Pi coding agent (desktop + mobile + web)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/pie"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/protocol",
    "packages/client",
    "packages/daemon",
    "packages/app",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:daemon": "tsx watch packages/daemon/src/index.ts --listen 127.0.0.1:8760",
    "dev": "npm run dev:daemon",
    "daemon": "tsx packages/daemon/src/index.ts",
    "smoke": "tsx scripts/pie-smoke.mts",
    "ui-walkthrough": "node scripts/ui-walkthrough.mjs",
    "check": "npm run typecheck && npm run test",
    "app": "npm run start -w @pie/app",
    "app:web": "npm run start -w @pie/app -- --web",
    "app:build:web": "npm run export:web -w @pie/app",
    "use": "node scripts/use.mjs"
  },
  "devDependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "~58.0.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react-dom": "~19.1.0",
    "expo-constants": "58.0.13",
    "jsdom": "^20.0.3",
    "playwright-core": "^1.64.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
