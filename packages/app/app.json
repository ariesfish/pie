{
	"expo": {
		"name": "Pie",
		"slug": "pie",
		"scheme": "pie",
		"version": "0.1.0",
		"orientation": "default",
		"userInterfaceStyle": "light",
		"backgroundColor": "#FFFFFF",
		"platforms": [
			"ios",
			"android",
			"web"
		],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "dev.pie.app"
		},
		"android": {
			"package": "dev.pie.app"
		},
		"web": {
			"bundler": "metro",
			"output": "single"
		},
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"plugins": [
			"expo-router",
			"expo-status-bar"
		]
	}
}
