{
	appId: "dev.pie.app",
	productName: "Pie",
	directories: { output: "dist-out" },
	files: ["electron/**", "dist/sidecar-manager.js", "package.json"],
	extraResources: [
		{ from: "dist/pie-runtime.tgz", to: "pie-runtime.tgz" },
		{ from: "dist/app-web", to: "app-web" },
	],
	mac: {
		category: "public.app-category.developer-tools",
		target: [{ target: "default", arch: ["arm64"] }],
		identity: null,
	},
	// Linux is not a shipping target; the dir target keeps `pack` usable for
	// the packaged smoke on Linux CI without snap/AppImage tooling.
	linux: {
		target: ["dir"],
		executableName: "pie",
	},
	asar: true,
	electronVersion: "37.10.3",
}
